<!-- slack15.1 backend switch -->
<FILE Min="6.13.0" Run="/bin/bash">
<INLINE>
CONFIG=&plgPATH;/&name;.cfg
if [ -e "$CONFIG" ]; then
    source "$CONFIG"
    if [ "$BACKEND" == "uv" ]; then
        # We already installed it above, just inform the user what backend was chosen.
        echo "Installing user-configured UV backend for Python3..."
    elif [ "$BACKEND" == "next" ]; then
        echo "Installing user-configured 3.14.x backend for Python3..."
        upgradepkg --install-new --terse &plgPATH;/python3-3.14.4-x86_64-1dwn_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-pip-26.1-x86_64-1dwn_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-setuptools-82.0.1-x86_64-1dwn_slack15.1.txz
    elif [ "$BACKEND" == "latest" ]; then
        echo "Installing user-configured 3.13.x backend for Python3..."
        upgradepkg --install-new --terse &plgPATH;/python3-3.13.13-x86_64-1dwl_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-pip-26.1-x86_64-1dwl_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-setuptools-82.0.1-x86_64-1dwl_slack15.1.txz
    elif [ "$BACKEND" == "previous" ]; then
        echo "Installing user-configured 3.12.x backend for Python3...."
        upgradepkg --install-new --terse &plgPATH;/python3-3.12.13-x86_64-1dwp_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-pip-26.1-x86_64-1dwp_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-setuptools-82.0.1-x86_64-1dwp_slack15.1.txz
    elif [ "$BACKEND" == "default" ]; then
        echo "Installing default 3.11.x backend for Python3..."
        upgradepkg --install-new --terse &plgPATH;/python3-3.11.15-x86_64-1dw_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-pip-26.1-x86_64-1dw_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-setuptools-82.0.1-x86_64-1dw_slack15.1.txz
    else
        echo "Installing default 3.11.x backend for Python3..."
        upgradepkg --install-new --terse &plgPATH;/python3-3.11.15-x86_64-1dw_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-pip-26.1-x86_64-1dw_slack15.1.txz
        upgradepkg --install-new --terse &plgPATH;/python-setuptools-82.0.1-x86_64-1dw_slack15.1.txz
    fi
else
    echo "Installing default 3.11.x backend for Python3..."
    upgradepkg --install-new --terse &plgPATH;/python3-3.11.15-x86_64-1dw_slack15.1.txz
    upgradepkg --install-new --terse &plgPATH;/python-pip-26.1-x86_64-1dw_slack15.1.txz
    upgradepkg --install-new --terse &plgPATH;/python-setuptools-82.0.1-x86_64-1dw_slack15.1.txz
fi
echo ""
</INLINE>
</FILE>

